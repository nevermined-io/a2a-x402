# Nevermined X402 Demo - Environment Configuration Template
# Copy this file to .env and fill in your values
#
# This demo always uses REAL BLOCKCHAIN TRANSACTIONS
# All payments will redeem credits on-chain
# =============================================================================
# Nevermined Configuration (REQUIRED)
# =============================================================================
# Server Agent (Merchant) - API key with permissions to verify/settle payments
# This represents the merchant/service provider
# Get this from: https://nevermined.app/permissions/global-permissions
NVM_API_KEY_SERVER=sandbox-staging:eyJhbGciOiJFUzI1NksifQ..n51gkto9Jw-MXxnXW92XDAB_CnHUFxkritWp9Lj1qFASmtf_TuQwU57bauIEGrQygumX8S3pXqRqeGRWT2AJiRs
# Client Agent (Subscriber) - API key with permissions to generate access tokens
# This represents the subscriber/customer
# Get this from: https://nevermined.app/permissions/global-permissions
NVM_API_KEY_CLIENT=sandbox-staging:eyJhbGciOiJFUzI1NksifQ..WcVy1LUl8r1Z7lTDCxdXltGhHBXrBUhxqjWrGu2nMaZ2UePqfV6Wrw2vcBcjrG5F2hrVacdCmHqC3pIrjiV3xBw
# Nevermined environment: sandbox or production
# - sandbox: For development and testing (uses testnet)
# - production: For live deployments
NVM_ENVIRONMENT=staging_sandbox
# =============================================================================
# Google ADK Configuration
# =============================================================================
# Google Generative AI API key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyCfx-foKFrZ9AUhPWe6fqZSCfmqycFMOeI
# =============================================================================
# Agent Configuration
# =============================================================================
# Payment Plan ID from Nevermined (REQUIRED)
# Register your payment plans (as Agent Owner) in Nevermined: https://nevermined.app/pricing-plans
NVM_CREDITS_PLAN_ID=108049205517037458937731288202562272535839301659429499119214601955897885058399
NVM_PAYASYOUGO_PLAN_ID=62394875242609859677277111792165973450905709107028029787650786307704351020504
# AI Agent ID from Nevermined (REQUIRED)
# Register your AI Agents in Nevermined: https://nevermined.app/agents
NVM_AGENT_ID=2494368510178916230703135426153690490133277298381571617383167590258071002716
# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. ALL TRANSACTIONS ARE REAL - Credits will be burned on the blockchain
# 2. Ensure you have sufficient credits in your Nevermined plan
# 3. Never commit this file with real credentials to version control
# 4. Transaction hashes can be verified on blockchain explorers
# 5. No mock or simulation mode - always uses real blockchain
